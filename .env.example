# Non-secret configuration only. Secrets live in Secret Manager (see README).

GCP_PROJECT=my-wallet-project

# Public HTTPS base URL. Apple embeds this in the pass as webServiceURL and calls
# back to it, so it must be the real external URL - not localhost.
SERVICE_BASE_URL=https://cards.example.org

# Apple
APPLE_TEAM_ID=ABCDE12345
APPLE_PASS_TYPE_ID=pass.au.org.example.membership
APPLE_APNS_KEY_ID=XYZ9876543
# api.push.apple.com (prod) | api.sandbox.push.apple.com (dev)
APPLE_APNS_HOST=api.push.apple.com

# Google Wallet
GOOGLE_ISSUER_ID=3388000000012345678
GOOGLE_CLASS_SUFFIX=membership

# Branding / behaviour
ORG_NAME=Example Association
SUPPORT_EMAIL=support@example.org
EMAIL_SENDER=noreply@example.org
MAX_DEVICES_PER_MEMBER=2
